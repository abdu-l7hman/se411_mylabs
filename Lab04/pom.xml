<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>psu.se411</groupId>
	<artifactId>Lab04-Maven-Intro</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<!-- Ex 2: Project Information -->
	<name>SE411 Construction Management System</name>
	<description>This project is a Construction Management System developed as part of the SE411 Software Engineering course. It provides tools to manage construction projects, tasks, and resources.</description>
	<url>https://se411-constructionms.example.com</url>

	<!-- Ex 2: License Information -->
	<licenses>
		<license>
			<name>Apache License 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<!-- Ex 2: Organization Information -->
	<organization>
		<name>SE411-Tech-Company</name>
		<url>https://se411-tech-company.example.com</url>
	</organization>

	<!-- Ex 2: Developer Information -->
	<developers>
		<developer>
			<name>Abdulrhman</name>
			<email>abdulrhman@se411.com</email>
		</developer>
	</developers>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<!-- Ex 1: JavaFX Dependency -->
	<dependencies>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>23</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Ex 1: JavaFX Maven Plugin -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>psu.se411.constructionms.MainApp</mainClass>
				</configuration>
			</plugin>

			<!-- Ex 2: Maven Site Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.12.1</version>
			</plugin>

			<!-- Required for site generation -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
		</plugins>
	</build>

</project>
